{
  // 知識小花園新網址 garden.ai30class.com（2026-10-26 定；跟同在 ai30class.github.io 的 Charis 分開，同源規矩 E2）
  // 純靜態：只放 deploy/ 的檔案，沒有程式（沒有 main），不存在的網址 Cloudflare 直接回 404
  // 舊網址 ai30class.github.io/knowledge-garden-homework/ 照舊由 GitHub Pages 的 docs/ 提供（不要在 GitHub 設自訂網域，怕舊網址被轉走、舊資料拿不出來）
  "name": "knowledge-garden",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./deploy" },
  "routes": [{ "pattern": "garden.ai30class.com", "custom_domain": true }]
}
